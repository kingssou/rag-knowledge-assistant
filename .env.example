# 复制本文件为 .env（同目录），按需取消注释并填入 Key。
# .env 已在 .gitignore 中，不会被提交。
# 改完运行 python main.py check 验证是否接通。

# ---------- 方案一：DeepSeek（国内直连、便宜，推荐） ----------
LLM_MODE=openai
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-在这里填你的key

# ---------- 方案二：阿里通义千问（DashScope 兼容模式） ----------
# LLM_MODE=openai
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# DASHSCOPE_API_KEY=sk-在这里填你的key

# ---------- 方案三：智谱 GLM ----------
# LLM_MODE=openai
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
# ZHIPU_API_KEY=在这里填你的key

# ---------- 方案四：月之暗面 Kimi ----------
# LLM_MODE=openai
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k
# MOONSHOT_API_KEY=sk-在这里填你的key

# ---------- 方案五：本地 Ollama（无需 Key，需先 ollama pull qwen2.5:3b） ----------
# LLM_MODE=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# ---------- 可选：换更真实的向量模型 ----------
# EMBED_MODEL=sentence-transformers
# EMBED_MODEL_NAME=all-MiniLM-L6-v2

# ---------- 可选：生成参数 ----------
# TEMPERATURE=0.1
# MAX_TOKENS=600
# MIN_CONFIDENCE=0.22
